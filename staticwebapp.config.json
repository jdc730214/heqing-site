{
  "routes": [
    {
      "route": "/admin",
      "rewrite": "/admin/index.html"
    },
    {
      "route": "/admin/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/icope",
      "rewrite": "/icope/index.html"
    },
    {
      "route": "/icope/index.html"
    },
    {
      "route": "/icope/script.js"
    },
    {
      "route": "/icope/license.js"
    },
    {
      "route": "/icope/shared-storage.js"
    },
    {
      "route": "/icope/fonts/*"
    },
    {
      "route": "/icope/images/*"
    },
    {
      "route": "/icope/libs/*"
    },
    {
      "route": "/icope/sounds/*"
    },
    {
      "route": "/icope/*",
      "rewrite": "/icope/index.html"
    },
    {
      "route": "/bodygo3_0",
      "rewrite": "/bodygo3_0/operator-manual.html"
    },
    {
      "route": "/sppb",
      "redirect": "/bodygo3_0/DM/bodygo3-intro.html",
      "statusCode": 301
    },
    {
      "route": "/bodygo",
      "redirect": "/bodygo3_0/DM/bodygo3-intro.html",
      "statusCode": 301
    },
    {
      "route": "/icope-info",
      "redirect": "/icope/",
      "statusCode": 301
    },
    {
      "route": "/heart-training",
      "redirect": "/heqinghealth_HR_TrainingDM/",
      "statusCode": 301
    },
    {
      "route": "/sitemap.xml",
      "headers": {
        "Content-Type": "application/xml",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "route": "/robots.txt",
      "headers": {
        "Content-Type": "text/plain",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "route": "/azure-cost",
      "rewrite": "/azure-cost/index.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/.well-known/*",
      "/admin/*",
      "/icope/*",
      "/bodygo3_0/*",
      "/sitemap.xml",
      "/robots.txt",
      "/bodygo3_0/DM/*",
      "/bodygo3_0/images/*",
      "/bodygo3_0/images/adult/*",
      "/bodygo3_0/images/elder/*",
      "/bodygo3_0/images/fall/*",
      "/bodygo3_0/images/sppb/*",
      "/bodygo3_0/DM/frames/3m-shuttle-walk/*",
      "/bodygo3_0/DM/frames/chair-sit-and-reach/*",
      "/bodygo3_0/DM/frames/chair-stand-30s/*",
      "/bodygo3_0/DM/frames/eyes-open-balance/*",
      "/bodygo3_0/DM/frames/functional-reach/*",
      "/bodygo3_0/DM/frames/march-in-place-2min/*",
      "/bodygo3_0/DM/frames/ppb-gait-4m/*",
      "/bodygo3_0/DM/frames/single-leg-stance-eyes-closed/*",
      "/bodygo3_0/DM/frames/sit-and-reach/*",
      "/bodygo3_0/DM/frames/sit-to-stand-5x/*",
      "/bodygo3_0/DM/frames/sit-up/*",
      "/bodygo3_0/DM/frames/sppb-chair-stand-5x/*",
      "/bodygo3_0/DM/frames/walk-2p44m/*",
      "/bodygo3_0/DM/frames/坐站/*",
      "/bodygo3_0/DM/frames/成人-心肺適能/*",
      "/bodygo3_0/DM/frames/銀髮上肢肌耐力/*",
      "/azure-cost/*"
    ]
  }
}
