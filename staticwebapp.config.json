{
  "routes": [
    {
      "route": "/admin",
      "rewrite": "/admin/index.html"
    },
    {
      "route": "/admin/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/icope",
      "rewrite": "/icope/index.html"
    },
    {
      "route": "/icope/index.html"
    },
    {
      "route": "/icope/script.js"
    },
    {
      "route": "/icope/license.js"
    },
    {
      "route": "/icope/shared-storage.js"
    },
    {
      "route": "/icope/fonts/*"
    },
    {
      "route": "/icope/images/*"
    },
    {
      "route": "/icope/libs/*"
    },
    {
      "route": "/icope/sounds/*"
    },
    {
      "route": "/icope/*",
      "rewrite": "/icope/index.html"
    },
    {
      "route": "/bodygo3_0",
      "rewrite": "/bodygo3_0/operator-manual.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/.well-known/*", "/admin/*", "/icope/*", "/bodygo3_0/*", "/bodygo3_0/*/*", "/bodygo3_0/*/*/*", "/bodygo3_0/*/*/*/*"]
  }
}
