{
  "routes": [
    {
      "route": "/admin",
      "rewrite": "/admin/index.html"
    },
    {
      "route": "/admin/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/icope",
      "rewrite": "/icope/index.html"
    },
    {
      "route": "/icope/*",
      "rewrite": "/icope/index.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/.well-known/*", "/admin/*", "/icope/*"]
  }
}
